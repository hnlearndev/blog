# Example environment configuration file
# Copy this to .env and fill in your actual values
# DO NOT commit the actual .env file to version control

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/blog_dev
# For production, use connection string with SSL:
# DATABASE_URL=postgres://username:password@host:5432/blog_prod?sslmode=require

# Application Environment
LEPTOS_ENV=DEV  # Options: DEV, STAGING, PROD
LEPTOS_SITE_ADDR=127.0.0.1:3000
LEPTOS_SITE_ROOT=./target/site
LEPTOS_SITE_PKG_DIR=pkg

# Logging
RUST_LOG=debug  # Options: trace, debug, info, warn, error

# Security
CSRF_SECRET_KEY=your-random-32-byte-base64-string-here
JWT_SECRET=your-random-jwt-secret-here

# Monitoring (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Email Service (if implementing email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=10

# External Services (optional)
CLOUDFLARE_API_TOKEN=your-cloudflare-token
ANALYTICS_ID=your-analytics-id

# Production-specific (Fly.io)
FLY_APP_NAME=your-fly-app-name
FLY_REGION=sin  # Singapore region